# =============================================================================
# Mise Config (Template)
# =============================================================================
# This is an example of the generated mise config.
# The real file is auto-generated by install.sh and lives at:
#   mise/.config/mise/config.toml
# That generated file is intentionally gitignored to avoid dirty diffs.
#
# To add or remove tools permanently, edit apps.toml entries with:
#   type = "mise"
#
# Then re-run install.sh to regenerate the config.
# =============================================================================

[tools]
# Example entries (generated from apps.toml):
# starship = "latest"
# eza      = "latest"
# node     = "lts"
# python   = "3.14"

[settings]
log_level = "info"
experimental = true
minimum_release_age_excludes = ["claude", "codex", "grok", "opencode", "pi"]
# mise upgrades every global tool in the background, checked every 24 hours,
# and updates itself daily. Exact versions never move. Needs mise 2026.10.7.
tool_update.global_auto = true
self_update.auto = "1d"
# Linux: use the prebuilt Erlang for Ubuntu 24.04. This is the build that
# `mise lock` on macOS records for Linux, so `mise install` keeps that
# record in a project's mise.lock. Ubuntu 26.04 is not detected by itself.
erlang.precompiled_os = "ubuntu-24.04"
